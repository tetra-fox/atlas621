{
  "name": "atlas621",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt .",
    "lint": "oxfmt --check . && oxlint",
    "fmt": "pnpm format",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^26.5.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tailwindcss": "^1.12.0",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "dependencies": {
    "@cosmos.gl/graph": "3.4.1",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource/dejavu-sans": "^5.3.0",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@lucide/svelte": "^1.46.0",
    "@number-flow/svelte": "^0.4.2",
    "apache-arrow": "^21.2.0",
    "bits-ui": "^2.19.2"
  }
}
