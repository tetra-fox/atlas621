{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas621",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "atlas621.net", "custom_domain": true },
    { "pattern": "www.atlas621.net", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
